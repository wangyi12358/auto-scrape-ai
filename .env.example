WXT_DEFAULT_OPENAI_API_KEY=sk-xxx
WXT_DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
WXT_DEFAULT_OPENAI_MODEL=gpt-4.1-mini

# 一行一个，或逗号分隔都行
WXT_DEFAULT_INCLUDE_RULES=current-tab-host
# 例如：
# WXT_DEFAULT_INCLUDE_RULES=^dapps-rankings\.dappradar\.com$,current-tab-host

WXT_DEFAULT_TARGET_LANGUAGE=python
WXT_DEFAULT_SCHEMA_TYPE=typescript-interface

# DevTools 面板：同时分析条数（1–32），默认 4
# WXT_DEFAULT_MAX_CONCURRENT_ANALYSIS=4
# 单次分析超时毫秒（10_000–600_000），默认 60000
# WXT_DEFAULT_ANALYSIS_TIMEOUT_MS=60000